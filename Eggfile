# status: buildable
# Sandbox Linux. The house desktop: the Garuda GNOME look
# (dark by default with a light scheme a click away, a floating dock, the search
# pill, a poster wallpaper per scheme, a Welcome window) on Debian 13 with GNOME 48,
# Chrome, Firefox, and Claude + ChatGPT/Codex (desktop apps and CLIs) on the dock.
#
# Base: egg/debian-13 (stable, apt, glibc — the audience is people who found
# Ubuntu hard; nothing may break or refuse to run). Desktop: GNOME 48 without
# recommends, Dash to Dock for the dock. Theme: stock Adwaita, dark, with the
# yellow accent (libadwaita apps follow it natively; no GTK theme to maintain).
# Icons: Papirus-Dark (GPL-3), trimmed to the two variants in use. Font: Inter.
# Greeter: GDM, autologin. Browsers: Chrome, Google's own arm64 build from
# dl.google.com (what people know), and Firefox from Mozilla's apt repository
# (WebGPU on the GPU; Chrome's WebGPU cannot reach it from inside a VM).
# Published as egg/sandbox; EggRun/docs/sandbox keeps the research notes and test history.

BOOT mode=uefi
FROM egg/debian-13
CLASS M
TITLE "Sandbox Linux"
LOGIN_USER sandbox
LOGIN_PASSWORD sandbox
LOGIN_AUTOLOGIN true
LOGIN_HELPTEXT "Signed in as sandbox by itself. When the system asks for a password (installing an app, changing a setting), use the one below."
GPU virgl vram=2G
DISPLAY 1280x800 scale=2
NETWORK restricted

LABEL description="Sandbox Linux: a beautiful, easy Linux desktop with Chrome, Firefox, Claude and Codex, sealed inside an egg." category="Desktop" tags="sandbox,debian,gnome,chrome,firefox,webgpu,desktop" license="EggRun EULA"
LOGO logo.png

INSTALL agent

# Every package at Debian's current stable + security level before anything
# is added on top: the hub scans each build against OSV, and an egg we make
# ourselves ships with the fixes Debian has already published.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
# GNOME 48 without recommends: the shell, session, GDM, the core apps, Dash to
# Dock for the Garuda-style floating dock, AppIndicator for tray icons, the
# extensions pack for user-theme. Recommends would pull games, printing,
# Evolution, the full GNOME.
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gnome-shell gnome-session gdm3 gnome-control-center gnome-settings-daemon \
    nautilus gnome-console gnome-text-editor evince file-roller loupe gnome-calculator \
    gnome-shell-extension-dash-to-dock gnome-shell-extension-appindicator gnome-shell-extensions gnome-shell-extension-prefs gnome-menus gnome-tweaks \
    libgl1-mesa-dri mesa-vulkan-drivers network-manager xdg-user-dirs \
    fonts-inter fonts-noto-core fonts-noto-color-emoji papirus-icon-theme \
    dbus-user-session pipewire-audio python3-gi gir1.2-gtk-3.0 wget ca-certificates xz-utils
# Chrome: Google's arm64 .deb; its postinst registers Google's apt repo and key.
RUN wget -qO /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_arm64.deb \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/chrome.deb && rm /tmp/chrome.deb
# Firefox, current, from Mozilla's own apt repository: WebGPU on the egg's GPU.
# Chrome's WebGPU needs a Vulkan-to-GL handoff that no VM can give it; Firefox
# runs WebGPU on wgpu straight over Vulkan, which Venus serves to the Mac's GPU.
# Debian's firefox-esr (140) has WebGPU compiled out, so it has to be Mozilla's
# build, pinned so apt never swaps it for the ESR.
RUN install -d -m 0755 /etc/apt/keyrings \
 && wget -qO /etc/apt/keyrings/packages.mozilla.org.asc https://packages.mozilla.org/apt/repo-signing-key.gpg \
 && gpg --show-keys --with-fingerprint /etc/apt/keyrings/packages.mozilla.org.asc | grep -q "35BA A0B3 3E9E B396 F59C  A838 C0BA 5CE6 DC63 15A3" \
 && echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" > /etc/apt/sources.list.d/mozilla.list \
 && printf 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n' > /etc/apt/preferences.d/mozilla \
 && apt-get update && apt-cache policy firefox | grep -q "packages.mozilla.org" \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends firefox \
 && firefox --version
# Firefox 158 on Linux still keeps WebGPU behind dom.webgpu.enabled; the policy
# file turns it on for every profile ("default" keeps it changeable in about:config).
# dom.webgpu.allow-present-without-readback: the WebGPU canvas reaches the
# compositor as a shared texture (a dma_buf the patched Mesa below can export)
# instead of a per-frame readback Firefox polls on a 100 ms timer: a heavy page
# went from 20 fps to the display's 120 on the Ubuntu desktop egg. Harmless
# where the shared path is unavailable: Firefox falls back by itself.
RUN install -d -m 0755 /etc/firefox/policies \
 && printf '{"policies":{"Preferences":{"dom.webgpu.enabled":{"Value":true,"Status":"default"},"dom.webgpu.allow-present-without-readback":{"Value":true,"Status":"default"}}}}\n' > /etc/firefox/policies/policies.json \
 && python3 -c 'import json; p=json.load(open("/etc/firefox/policies/policies.json"))["policies"]["Preferences"]; assert p["dom.webgpu.enabled"]["Value"] is True, p; assert p["dom.webgpu.allow-present-without-readback"]["Value"] is True, p'

# ── Firefox on a patched Mesa: WebGPU presents without a readback ────────
# Firefox's shared-texture swap chain wants OPAQUE_FD-exportable Vulkan
# semaphores and GL_EXT_semaphore_fd; Debian's Mesa offers neither on
# virtio-gpu, so its 25.0.7 source is rebuilt with a four-file patch
# (mesa-egg.sh explains it; canonical copies in EggRun's egg-drivers/linux-gpu)
# into /opt/mesa-egg, and only Firefox is pointed at it through
# /usr/local/bin/firefox. GNOME and Chrome keep Debian's Mesa. The host side is
# the runner's EGG_VENUS_SHARED_PRESENT (on by default since 0.6.41). Build
# deps go on for the build and are purged again by the script.
COPY mesa-egg-25.0.patch /usr/local/lib/egg/mesa-egg-25.0.patch
COPY mesa-egg-26.0.patch /usr/local/lib/egg/mesa-egg-26.0.patch
COPY mesa-egg.sh /usr/local/lib/egg/mesa-egg.sh
RUN bash /usr/local/lib/egg/mesa-egg.sh
COPY firefox-mesa-egg /usr/local/bin/firefox
RUN chmod 0755 /usr/local/bin/firefox
RUN test -f /opt/mesa-egg/lib/aarch64-linux-gnu/libvulkan_virtio.so
RUN test -f /opt/mesa-egg/lib/aarch64-linux-gnu/dri/virtio_gpu_dri.so
RUN sh -c 'test "$(command -v firefox)" = /usr/local/bin/firefox'
RUN /usr/local/bin/firefox --version
RUN sh -c '! dpkg -s meson >/dev/null 2>&1'

# Firefox 158 crashes on quit whenever a WebGPU page is open: wgpu drops its
# Vulkan instance, the loader dlcloses the Venus driver, and the CanvasRenderer
# thread is still inside it (SIGSEGV at an unmapped PC; the crash reporter on
# every quit). The Vulkan loader has a switch for exactly that; pam_env puts
# /etc/environment into the GNOME session, so every dock launch gets it.
# Verified 2026-10-16: three quits with the switch clean, the control crashed.
RUN echo 'VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING=1' >> /etc/environment
# AI on the dock. Claude Desktop (Anthropic's Linux beta) and Claude Code come
# from Anthropic's signed apt repositories, so apt keeps them current; the
# ChatGPT app with Codex (OpenAI's Linux preview) is OpenAI's own arm64 .deb,
# whose postinst registers OpenAI's repository; the Codex CLI is the npm
# package on Node 22 from NodeSource. All four sign in on first launch.
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl gnupg \
 && install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSLo /etc/apt/keyrings/claude-desktop.asc https://downloads.claude.ai/claude-desktop/key.asc \
 && curl -fsSLo /etc/apt/keyrings/claude-code.asc https://downloads.claude.ai/keys/claude-code.asc \
 && gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc | grep -q '^fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:' \
 && echo "deb [signed-by=/etc/apt/keyrings/claude-desktop.asc] https://downloads.claude.ai/claude-desktop/apt/stable stable main" > /etc/apt/sources.list.d/claude-desktop.list \
 && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" > /etc/apt/sources.list.d/claude-code.list \
 && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends claude-desktop claude-code \
 && claude --version
RUN wget -qO /tmp/chatgpt.deb https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/chatgpt_arm64.deb \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/chatgpt.deb && rm /tmp/chatgpt.deb
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - >/dev/null \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs \
 && npm install -g @openai/codex >/dev/null && codex --version
# The launchers the dock pins: the two apps come with their own (names read from
# the installed packages, not guessed); the two CLIs get one each, with the
# terminal icon, that opens Console with the tool running.
COPY ai/claude-code.desktop /usr/share/applications/claude-code.desktop
COPY ai/codex.desktop /usr/share/applications/codex.desktop
# Their icons: the terminal tile badged with each vendor's mark, so the dock
# reads at a glance which terminal is which.
COPY ai/icons/256/claude-cli.png /usr/share/icons/hicolor/256x256/apps/claude-cli.png
COPY ai/icons/256/codex-cli.png /usr/share/icons/hicolor/256x256/apps/codex-cli.png
COPY ai/icons/128/claude-cli.png /usr/share/icons/hicolor/128x128/apps/claude-cli.png
COPY ai/icons/128/codex-cli.png /usr/share/icons/hicolor/128x128/apps/codex-cli.png
COPY ai/icons/64/claude-cli.png /usr/share/icons/hicolor/64x64/apps/claude-cli.png
COPY ai/icons/64/codex-cli.png /usr/share/icons/hicolor/64x64/apps/codex-cli.png
COPY ai/icons/48/claude-cli.png /usr/share/icons/hicolor/48x48/apps/claude-cli.png
COPY ai/icons/48/codex-cli.png /usr/share/icons/hicolor/48x48/apps/codex-cli.png
# The EggRun mark (the desktop app's own icon) for the eggrun.ai tile.
COPY ai/icons/256/eggrun.png /usr/share/icons/hicolor/256x256/apps/eggrun.png
COPY ai/icons/128/eggrun.png /usr/share/icons/hicolor/128x128/apps/eggrun.png
COPY ai/icons/64/eggrun.png /usr/share/icons/hicolor/64x64/apps/eggrun.png
COPY ai/icons/48/eggrun.png /usr/share/icons/hicolor/48x48/apps/eggrun.png
RUN gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
RUN set -e; cd /usr/share/applications; \
    CLAUDE=$(grep -lis 'Exec=.*claude-desktop' *.desktop | head -n1); CHATGPT=$(grep -lis 'Exec=.*chatgpt' *.desktop | head -n1); \
    test -n "$CLAUDE" && test -n "$CHATGPT"; echo "dock: $CLAUDE $CHATGPT"; \
    printf '%s\n' "[org.gnome.shell]" "favorite-apps=['google-chrome.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', '$CLAUDE', 'claude-code.desktop', '$CHATGPT', 'codex.desktop', 'org.gnome.Settings.desktop', 'org.gnome.TextEditor.desktop', 'sandbox-welcome.desktop']" > /usr/share/glib-2.0/schemas/60_sandbox-dock.gschema.override
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Papirus ships five variants; the desktop uses Papirus-Dark (inherits Papirus).
RUN rm -rf /usr/share/icons/ePapirus /usr/share/icons/ePapirus-Dark /usr/share/icons/Papirus-Light

# Branding, defaults, GDM, Welcome.
COPY wallpaper-dark.jpg /usr/share/backgrounds/sandbox/sandbox-dark.jpg
COPY wallpaper-light.jpg /usr/share/backgrounds/sandbox/sandbox-light.jpg
COPY logo.png /usr/share/pixmaps/sandbox.png
COPY menu-sandbox.png /usr/share/pixmaps/sandbox-menu.png
COPY wordmark-dark.png /usr/share/pixmaps/sandbox-wordmark-dark.png
COPY wordmark-light.png /usr/share/pixmaps/sandbox-wordmark-light.png
# The dock is pinned (always visible, windows stop above it) and the top bar
# has an Applications menu (the apps-menu extension; it needs gnome-menus for
# the applications.menu it reads, which no-recommends left out): two ways to find an app that never hide, the way
# a Mac user expects. People who want it otherwise have the Extensions app
# (gnome-shell-extension-prefs): Dash to Dock's own settings live there.
COPY sandbox.gschema.override /usr/share/glib-2.0/schemas/50_sandbox.gschema.override
COPY gdm/daemon.conf /etc/gdm3/daemon.conf
COPY welcome/sandbox-welcome /usr/local/bin/sandbox-welcome
COPY welcome/sandbox-welcome.desktop /etc/xdg/autostart/sandbox-welcome.desktop
COPY welcome/sandbox-welcome-app.desktop /usr/share/applications/sandbox-welcome.desktop
COPY sandbox-release /etc/sandbox-release
RUN glib-compile-schemas /usr/share/glib-2.0/schemas && chmod 0755 /usr/local/bin/sandbox-welcome

# The network belongs to NetworkManager, so the shell's network indicator is
# live; the base's ifupdown stanza for eth0 would leave the device "unmanaged".
RUN sed -i '/eth0/d' /etc/network/interfaces

# The base image's test user goes; the desktop user is sandbox.
RUN userdel -r test 2>/dev/null || true
RUN useradd -m -u 1000 -s /bin/bash -c "Sandbox" -G sudo,video,audio,netdev sandbox && echo "sandbox:sandbox" | chpasswd
# The account picture: the sandbox mark, for GDM, the lock screen and the user menu.
RUN install -o sandbox -g sandbox -m 0644 /usr/share/pixmaps/sandbox.png /home/sandbox/.face \
 && mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users \
 && cp /usr/share/pixmaps/sandbox.png /var/lib/AccountsService/icons/sandbox \
 && printf '[User]\nIcon=/var/lib/AccountsService/icons/sandbox\nSystemAccount=false\n' > /var/lib/AccountsService/users/sandbox
RUN systemctl set-default graphical.target && systemctl enable gdm3 NetworkManager \
 && systemctl disable getty@tty1.service 2>/dev/null || true

# Size: documentation and spare locales are not what people download a desktop for.
RUN rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* \
 && find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' ! -name 'locale.alias' -exec rm -rf {} + \
 && printf 'path-exclude /usr/share/doc/*\npath-exclude /usr/share/man/*\npath-exclude /usr/share/info/*\npath-include /usr/share/doc/*/copyright\n' > /etc/dpkg/dpkg.cfg.d/01-nodoc

# Size: the stock GNOME wallpapers (ours live in backgrounds/sandbox), the build's
# journal and the installer log are not part of the product.
RUN rm -rf /usr/share/backgrounds/gnome /usr/share/gnome-background-properties /var/log/installer \
 && (journalctl --rotate; journalctl --vacuum-time=1s) >/dev/null 2>&1; find /var/log -type f -name '*.log' -exec truncate -s 0 {} + \
 && mkdir -p /etc/systemd/journald.conf.d && printf '[Journal]\nSystemMaxUse=48M\n' > /etc/systemd/journald.conf.d/50-sandbox.conf

# The warm snapshot ships every non-zero page of RAM. With init_on_free the
# kernel zeroes each page as it is freed, so at any moment only the live
# desktop is non-zero and every snapshot of this egg, including the ones a
# user takes, packs to the live set (~1-3% CPU on allocation-heavy work;
# nothing a desktop notices). The proper mechanism is a balloon device;
# until then this is the whole story.
RUN sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 init_on_free=1"/' /etc/default/grub \
 && grep -q 'init_on_free=1' /etc/default/grub && update-grub

# Last: give the freed blocks back. Everything deleted above (apt lists, the
# Chrome .deb, docs, the base image's test user) still sits on the disk as
# written data until the filesystem trims it; the disk zeroes trimmed ranges
# and the snapshot packer skips zero chunks, so the hub pack carries only
# what is live.
RUN sync && fstrim -v /

CMD ["/bin/sh"]
